{
  "name": "mfm-renderer",
  "version": "0.4.0",
  "description": "MFM (Misskey Flavored Markdown) を描画する Vue 3・React のコンポーネント。文法ごとにコンポーネントを分けている",
  "keywords": [
    "misskey",
    "mfm",
    "vue",
    "react",
    "vue3",
    "markdown",
    "renderer"
  ],
  "license": "MIT",
  "author": "fruitriin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fruitriin/mfm-renderer.git"
  },
  "homepage": "https://github.com/fruitriin/mfm-renderer#readme",
  "bugs": {
    "url": "https://github.com/fruitriin/mfm-renderer/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/MMFMRenderer.umd.cjs",
  "module": "./dist/MMFMRenderer.js",
  "types": "./dist/types/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/library.d.ts",
      "import": "./dist/MMFMRenderer.js",
      "require": "./dist/MMFMRenderer.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/style.css": "./dist/react/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode umd && vite build --mode react && vue-tsc -p tsconfig.build.json && tsc -p tsconfig.react.build.json && node scripts/strip-css-imports.mjs",
    "pages": "vue-tsc --noEmit && vite build -c vite.config.docs.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.11",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "mfm-js": "^0.28.0",
    "misskey-js": "^2026.10.1",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
