{
  "name": "mfm-renderer",
  "version": "0.3.0",
  "description": "MFM (Misskey Flavored Markdown) を描画する Vue 3 コンポーネント。文法ごとにコンポーネントを分けている",
  "keywords": [
    "misskey",
    "mfm",
    "vue",
    "vue3",
    "markdown",
    "renderer"
  ],
  "license": "MIT",
  "author": "fruitriin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fruitriin/mfm-renderer.git"
  },
  "homepage": "https://github.com/fruitriin/mfm-renderer#readme",
  "bugs": {
    "url": "https://github.com/fruitriin/mfm-renderer/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/MMFMRenderer.umd.cjs",
  "module": "./dist/MMFMRenderer.js",
  "types": "./dist/types/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/library.d.ts",
      "import": "./dist/MMFMRenderer.js",
      "require": "./dist/MMFMRenderer.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode umd && vue-tsc -p tsconfig.build.json",
    "pages": " vue-tsc  --emitDeclarationOnly && vite build -c vite.config.docs.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "dependencies": {
    "mfm-js": "^0.28.0",
    "misskey-js": "^2026.10.1",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^23.0.1",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "~5.3.0",
    "vite": "^5.0.10",
    "vitest": "^1.0.4",
    "vue": "^3.3.11",
    "vue-tsc": "^1.8.25"
  }
}
